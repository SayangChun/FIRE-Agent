{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-agent/schemas/report.json",
  "title": "FIRE Report",
  "description": "Complete FIRE (Financial Independence, Retire Early) analysis report with all analysis sections, findings, and recommendations.",
  "type": "object",
  "required": [
    "executive_summary",
    "financial_profile",
    "fire_number_analysis",
    "current_progress",
    "savings_rate_analysis",
    "estimated_fire_age",
    "scenario_analysis",
    "monte_carlo_results",
    "fire_type_classification",
    "risk_analysis",
    "tradeoff_analysis",
    "recommended_actions",
    "assumptions",
    "disclaimer"
  ],
  "properties": {
    "executive_summary": {
      "$ref": "#/$defs/executive_summary"
    },
    "financial_profile": {
      "$ref": "#/$defs/financial_profile_section"
    },
    "fire_number_analysis": {
      "$ref": "#/$defs/fire_number_analysis"
    },
    "current_progress": {
      "$ref": "#/$defs/current_progress"
    },
    "savings_rate_analysis": {
      "$ref": "#/$defs/savings_rate_analysis"
    },
    "estimated_fire_age": {
      "$ref": "#/$defs/estimated_fire_age"
    },
    "scenario_analysis": {
      "$ref": "#/$defs/scenario_analysis"
    },
    "monte_carlo_results": {
      "$ref": "#/$defs/monte_carlo_results"
    },
    "fire_type_classification": {
      "$ref": "#/$defs/fire_type_classification"
    },
    "risk_analysis": {
      "$ref": "#/$defs/risk_analysis"
    },
    "tradeoff_analysis": {
      "$ref": "#/$defs/tradeoff_analysis"
    },
    "recommended_actions": {
      "$ref": "#/$defs/recommended_actions"
    },
    "assumptions": {
      "$ref": "#/$defs/assumptions"
    },
    "disclaimer": {
      "type": "string",
      "description": "Legal disclaimer and limitations of the analysis."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "executive_summary": {
      "type": "object",
      "description": "High-level overview of the FIRE analysis results.",
      "required": ["current_net_worth", "fire_number", "years_to_fire", "readiness_grade", "one_liner", "key_findings"],
      "properties": {
        "current_net_worth": {
          "type": "number",
          "description": "Total current net worth (assets minus liabilities)."
        },
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "Target portfolio size for financial independence."
        },
        "years_to_fire": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated years remaining until FIRE."
        },
        "readiness_grade": {
          "type": "string",
          "enum": ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "F"],
          "description": "Overall FIRE readiness grade."
        },
        "one_liner": {
          "type": "string",
          "description": "One-sentence summary of the FIRE outlook."
        },
        "key_findings": {
          "type": "array",
          "description": "Top 3-5 key findings from the analysis.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "financial_profile_section": {
      "type": "object",
      "description": "Summary of the user's financial profile used in the analysis.",
      "required": ["age", "target_fire_age", "country", "currency", "annual_income", "annual_expenses", "total_assets", "total_liabilities", "net_worth"],
      "properties": {
        "age": {
          "type": "integer",
          "description": "Current age."
        },
        "target_fire_age": {
          "type": "integer",
          "description": "Desired FIRE age."
        },
        "country": {
          "type": "string",
          "description": "Country of residence."
        },
        "currency": {
          "type": "string",
          "description": "Currency used for all values."
        },
        "annual_income": {
          "type": "number",
          "description": "Annual net income."
        },
        "annual_expenses": {
          "type": "number",
          "description": "Annual living expenses."
        },
        "total_assets": {
          "type": "number",
          "description": "Sum of all asset holdings."
        },
        "total_liabilities": {
          "type": "number",
          "description": "Sum of all debts and liabilities."
        },
        "net_worth": {
          "type": "number",
          "description": "Total assets minus total liabilities."
        },
        "asset_allocation": {
          "type": "object",
          "description": "Breakdown of assets by category.",
          "properties": {
            "cash": { "type": "number", "description": "Cash holdings." },
            "stocks": { "type": "number", "description": "Individual stock holdings." },
            "etf": { "type": "number", "description": "ETF holdings." },
            "bonds": { "type": "number", "description": "Bond holdings." },
            "crypto": { "type": "number", "description": "Cryptocurrency holdings." },
            "real_estate": { "type": "number", "description": "Real estate equity." },
            "other": { "type": "number", "description": "Other assets." }
          },
          "additionalProperties": false
        },
        "liability_breakdown": {
          "type": "object",
          "description": "Breakdown of liabilities by category.",
          "properties": {
            "mortgage": { "type": "number", "description": "Mortgage balance." },
            "consumer_debt": { "type": "number", "description": "Consumer debt." },
            "other": { "type": "number", "description": "Other liabilities." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fire_number_analysis": {
      "type": "object",
      "description": "Detailed analysis of the FIRE number calculation.",
      "required": ["fire_number", "withdrawal_rate", "annual_retirement_expenses", "calculation_method", "comparison_to_benchmarks"],
      "properties": {
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "Calculated FIRE number."
        },
        "withdrawal_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Safe withdrawal rate used."
        },
        "annual_retirement_expenses": {
          "type": "number",
          "minimum": 0,
          "description": "Projected annual retirement expenses."
        },
        "calculation_method": {
          "type": "string",
          "description": "Method used to calculate the FIRE number (e.g., '4% rule', 'dynamic withdrawal')."
        },
        "comparison_to_benchmarks": {
          "type": "object",
          "description": "How the FIRE number compares to common benchmarks.",
          "properties": {
            "vs_median_household": {
              "type": "number",
              "description": "FIRE number as a multiple of median household net worth."
            },
            "vs_25x_expenses": {
              "type": "boolean",
              "description": "Whether the FIRE number meets the 25x annual expenses benchmark."
            },
            "vs_30x_expenses": {
              "type": "boolean",
              "description": "Whether the FIRE number meets the more conservative 30x benchmark."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "current_progress": {
      "type": "object",
      "description": "Current progress toward the FIRE number.",
      "required": ["current_assets", "fire_number", "progress_percentage", "remaining_amount", "progress_bar"],
      "properties": {
        "current_assets": {
          "type": "number",
          "minimum": 0,
          "description": "Current invested assets."
        },
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "Target FIRE number."
        },
        "progress_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Progress toward FIRE as a percentage."
        },
        "remaining_amount": {
          "type": "number",
          "minimum": 0,
          "description": "Remaining amount needed to reach FIRE."
        },
        "progress_bar": {
          "type": "string",
          "description": "Visual progress bar representation."
        }
      },
      "additionalProperties": false
    },
    "savings_rate_analysis": {
      "type": "object",
      "description": "Analysis of the current savings rate and its impact.",
      "required": ["current_savings_rate", "annual_savings", "monthly_savings", "savings_rate_assessment", "impact_on_timeline"],
      "properties": {
        "current_savings_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Current savings rate as a decimal."
        },
        "annual_savings": {
          "type": "number",
          "minimum": 0,
          "description": "Total annual savings."
        },
        "monthly_savings": {
          "type": "number",
          "minimum": 0,
          "description": "Total monthly savings."
        },
        "savings_rate_assessment": {
          "type": "string",
          "enum": ["excellent", "good", "average", "below_average", "needs_improvement"],
          "description": "Qualitative assessment of the savings rate."
        },
        "impact_on_timeline": {
          "type": "string",
          "description": "How the savings rate affects the FIRE timeline."
        },
        "sensitivity": {
          "type": "object",
          "description": "Impact of changing savings rate on FIRE timeline.",
          "properties": {
            "increase_5pct": {
              "type": "number",
              "description": "Change in years to FIRE if savings rate increases by 5 percentage points."
            },
            "increase_10pct": {
              "type": "number",
              "description": "Change in years to FIRE if savings rate increases by 10 percentage points."
            },
            "decrease_5pct": {
              "type": "number",
              "description": "Change in years to FIRE if savings rate decreases by 5 percentage points."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "estimated_fire_age": {
      "type": "object",
      "description": "Estimated age at which FIRE will be achieved.",
      "required": ["estimated_age", "years_remaining", "meets_target", "target_fire_age"],
      "properties": {
        "estimated_age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 100,
          "description": "Projected age at FIRE."
        },
        "years_remaining": {
          "type": "number",
          "minimum": 0,
          "description": "Years from now until projected FIRE."
        },
        "meets_target": {
          "type": "boolean",
          "description": "Whether the estimated FIRE age meets the user's target."
        },
        "target_fire_age": {
          "type": "integer",
          "description": "User's target FIRE age for comparison."
        },
        "gap": {
          "type": "integer",
          "description": "Difference between estimated and target FIRE age (negative = ahead of schedule)."
        }
      },
      "additionalProperties": false
    },
    "scenario_analysis": {
      "type": "object",
      "description": "FIRE projections under different market scenarios.",
      "required": ["conservative", "base", "optimistic", "scenario_comparison"],
      "properties": {
        "conservative": {
          "type": "object",
          "description": "Conservative scenario (lower returns, higher inflation).",
          "properties": {
            "annual_return": { "type": "number", "description": "Assumed annual return." },
            "inflation_rate": { "type": "number", "description": "Assumed inflation rate." },
            "fire_number": { "type": "number", "description": "FIRE number for this scenario." },
            "fire_age": { "type": "integer", "description": "Projected FIRE age." },
            "final_assets": { "type": "number", "description": "Portfolio value at FIRE." }
          },
          "additionalProperties": false
        },
        "base": {
          "type": "object",
          "description": "Base scenario (moderate returns, average inflation).",
          "properties": {
            "annual_return": { "type": "number", "description": "Assumed annual return." },
            "inflation_rate": { "type": "number", "description": "Assumed inflation rate." },
            "fire_number": { "type": "number", "description": "FIRE number for this scenario." },
            "fire_age": { "type": "integer", "description": "Projected FIRE age." },
            "final_assets": { "type": "number", "description": "Portfolio value at FIRE." }
          },
          "additionalProperties": false
        },
        "optimistic": {
          "type": "object",
          "description": "Optimistic scenario (higher returns, lower inflation).",
          "properties": {
            "annual_return": { "type": "number", "description": "Assumed annual return." },
            "inflation_rate": { "type": "number", "description": "Assumed inflation rate." },
            "fire_number": { "type": "number", "description": "FIRE number for this scenario." },
            "fire_age": { "type": "integer", "description": "Projected FIRE age." },
            "final_assets": { "type": "number", "description": "Portfolio value at FIRE." }
          },
          "additionalProperties": false
        },
        "scenario_comparison": {
          "type": "object",
          "description": "Comparison across scenarios.",
          "properties": {
            "age_spread": {
              "type": "integer",
              "description": "Difference between optimistic and conservative FIRE ages."
            },
            "most_likely": {
              "type": "string",
              "enum": ["conservative", "base", "optimistic"],
              "description": "Most likely scenario based on current trajectory."
            },
            "sensitivity_notes": {
              "type": "string",
              "description": "Key observations about scenario sensitivity."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "monte_carlo_results": {
      "type": "object",
      "description": "Monte Carlo simulation results for robustness analysis.",
      "required": ["success_probability", "median_final_assets", "simulation_count", "percentiles", "risk_metrics"],
      "properties": {
        "success_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of achieving FIRE across all simulations."
        },
        "median_final_assets": {
          "type": "number",
          "description": "Median final portfolio value."
        },
        "simulation_count": {
          "type": "integer",
          "minimum": 100,
          "description": "Number of Monte Carlo simulations run."
        },
        "percentiles": {
          "type": "object",
          "description": "Portfolio value distribution at key percentiles.",
          "properties": {
            "p10": { "type": "number", "description": "10th percentile (pessimistic)." },
            "p25": { "type": "number", "description": "25th percentile." },
            "p50": { "type": "number", "description": "50th percentile (median)." },
            "p75": { "type": "number", "description": "75th percentile." },
            "p90": { "type": "number", "description": "90th percentile (optimistic)." }
          },
          "additionalProperties": false
        },
        "risk_metrics": {
          "type": "object",
          "description": "Risk metrics from the simulation.",
          "properties": {
            "max_drawdown": {
              "type": "number",
              "description": "Maximum portfolio drawdown observed in simulations."
            },
            "shortfall_risk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of running out of money before death."
            },
            "recovery_time_months": {
              "type": "number",
              "description": "Average months to recover from worst-case drawdown."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fire_type_classification": {
      "type": "object",
      "description": "Classification of the type of FIRE achievable.",
      "required": ["type", "reason", "confidence", "type_definitions"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["lean_fire", "regular_fire", "fat_fire", "barista_fire", "coast_fire"],
          "description": "Classified FIRE type."
        },
        "reason": {
          "type": "string",
          "description": "Detailed explanation for this classification."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence level in this classification."
        },
        "type_definitions": {
          "type": "object",
          "description": "Definitions of each FIRE type for reference.",
          "properties": {
            "lean_fire": { "type": "string", "description": "FIRE with minimal expenses (typically < $40k/year)." },
            "regular_fire": { "type": "string", "description": "Standard FIRE with moderate expenses." },
            "fat_fire": { "type": "string", "description": "FIRE with generous expenses (typically > $100k/year)." },
            "barista_fire": { "type": "string", "description": "Part-time work to cover some expenses while investments grow." },
            "coast_fire": { "type": "string", "description": "Enough saved that compound growth alone will fund retirement." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "risk_analysis": {
      "type": "object",
      "description": "Comprehensive risk analysis identifying threats to the FIRE plan.",
      "required": ["risks", "overall_risk_level", "risk_summary"],
      "properties": {
        "risks": {
          "type": "array",
          "description": "List of identified risks.",
          "items": {
            "type": "object",
            "required": ["name", "severity", "probability", "reason", "mitigation", "category"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Risk name."
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"],
                "description": "Impact severity if risk materializes."
              },
              "probability": {
                "type": "string",
                "enum": ["unlikely", "possible", "likely", "very_likely"],
                "description": "Likelihood of the risk occurring."
              },
              "reason": {
                "type": "string",
                "description": "Why this risk exists."
              },
              "mitigation": {
                "type": "string",
                "description": "Recommended mitigation strategy."
              },
              "category": {
                "type": "string",
                "enum": ["market", "inflation", "health", "career", "tax", "behavioral", "black_swan"],
                "description": "Risk category."
              }
            },
            "additionalProperties": false
          }
        },
        "overall_risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Overall risk level of the FIRE plan."
        },
        "risk_summary": {
          "type": "string",
          "description": "Summary paragraph of the risk landscape."
        }
      },
      "additionalProperties": false
    },
    "tradeoff_analysis": {
      "type": "object",
      "description": "Analysis of key tradeoffs in pursuing the current FIRE path.",
      "required": ["tradeoffs", "summary"],
      "properties": {
        "tradeoffs": {
          "type": "array",
          "description": "List of identified tradeoffs.",
          "items": {
            "type": "object",
            "required": ["area", "description", "impact", "opportunity_cost"],
            "properties": {
              "area": {
                "type": "string",
                "description": "Life area affected."
              },
              "description": {
                "type": "string",
                "description": "Description of the tradeoff."
              },
              "impact": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Impact severity."
              },
              "opportunity_cost": {
                "type": "string",
                "description": "What is given up by choosing the current path."
              }
            },
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string",
          "description": "Summary of the tradeoff landscape."
        }
      },
      "additionalProperties": false
    },
    "recommended_actions": {
      "type": "object",
      "description": "Prioritized actionable recommendations.",
      "required": ["actions", "priority_summary", "quick_wins"],
      "properties": {
        "actions": {
          "type": "array",
          "description": "Ordered list of recommended actions.",
          "items": {
            "type": "object",
            "required": ["priority", "category", "action", "expected_impact", "effort", "timeline"],
            "properties": {
              "priority": {
                "type": "integer",
                "minimum": 1,
                "description": "Priority rank (1 = most important)."
              },
              "category": {
                "type": "string",
                "enum": ["savings", "income", "investment", "expenses", "tax", "debt", "insurance", "estate"],
                "description": "Action category."
              },
              "action": {
                "type": "string",
                "description": "Specific action to take."
              },
              "expected_impact": {
                "type": "string",
                "description": "Expected impact on FIRE timeline or security."
              },
              "effort": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Implementation effort."
              },
              "timeline": {
                "type": "string",
                "description": "Recommended timeline to implement."
              }
            },
            "additionalProperties": false
          }
        },
        "priority_summary": {
          "type": "string",
          "description": "Summary of the top priorities."
        },
        "quick_wins": {
          "type": "array",
          "description": "Low-effort, high-impact actions to start immediately.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "object",
      "description": "Key assumptions underlying the analysis.",
      "required": ["market_assumptions", "personal_assumptions", "economic_assumptions"],
      "properties": {
        "market_assumptions": {
          "type": "object",
          "description": "Assumptions about market conditions.",
          "properties": {
            "expected_return": { "type": "number", "description": "Expected annual investment return." },
            "inflation_rate": { "type": "number", "description": "Assumed inflation rate." },
            "withdrawal_rate": { "type": "number", "description": "Safe withdrawal rate used." },
            "return_volatility": { "type": "number", "description": "Assumed return volatility for Monte Carlo." }
          },
          "additionalProperties": false
        },
        "personal_assumptions": {
          "type": "object",
          "description": "Assumptions about personal circumstances.",
          "properties": {
            "income_growth_rate": { "type": "number", "description": "Expected annual income growth." },
            "expense_growth_rate": { "type": "number", "description": "Expected annual expense growth." },
            "retirement_expense_ratio": { "type": "number", "description": "Retirement expenses as ratio of current." },
            "life_expectancy": { "type": "integer", "description": "Assumed life expectancy for planning." }
          },
          "additionalProperties": false
        },
        "economic_assumptions": {
          "type": "object",
          "description": "Assumptions about broader economic conditions.",
          "properties": {
            "tax_rate": { "type": "number", "description": "Assumed effective tax rate." },
            "social_security": { "type": "boolean", "description": "Whether Social Security is included." },
            "healthcare_cost": { "type": "number", "description": "Assumed annual healthcare cost in retirement." }
          },
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "description": "Known limitations of the analysis.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
