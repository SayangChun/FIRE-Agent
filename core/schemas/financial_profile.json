{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-agent/schemas/financial_profile.json",
  "title": "Financial Profile",
  "description": "Complete financial profile for FIRE (Financial Independence, Retire Early) analysis. Captures personal details, income, expenses, assets, liabilities, and investment assumptions.",
  "type": "object",
  "required": ["personal", "income", "expenses", "assets", "liabilities", "investment"],
  "properties": {
    "personal": {
      "$ref": "#/$defs/personal"
    },
    "income": {
      "$ref": "#/$defs/income"
    },
    "expenses": {
      "$ref": "#/$defs/expenses"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "liabilities": {
      "$ref": "#/$defs/liabilities"
    },
    "investment": {
      "$ref": "#/$defs/investment"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "personal": {
      "type": "object",
      "description": "Personal information relevant to FIRE planning.",
      "required": ["age", "target_fire_age", "country", "currency"],
      "properties": {
        "age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 100,
          "description": "Current age of the individual."
        },
        "target_fire_age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 100,
          "description": "Desired age at which to achieve financial independence."
        },
        "country": {
          "type": "string",
          "description": "Country of residence, used for tax and cost-of-living context.",
          "default": "US"
        },
        "currency": {
          "type": "string",
          "description": "Currency used for all monetary values.",
          "default": "USD"
        }
      },
      "additionalProperties": false
    },
    "income": {
      "type": "object",
      "description": "Income details including current earnings and expected growth.",
      "required": ["monthly_income", "annual_income", "income_growth_rate"],
      "properties": {
        "monthly_income": {
          "type": "number",
          "minimum": 0,
          "description": "Net monthly income after taxes.",
          "default": 0
        },
        "annual_income": {
          "type": "number",
          "minimum": 0,
          "description": "Net annual income after taxes.",
          "default": 0
        },
        "income_growth_rate": {
          "type": "number",
          "minimum": -1,
          "maximum": 10,
          "description": "Expected annual income growth rate as a decimal (e.g., 0.03 for 3%).",
          "default": 0.03
        }
      },
      "additionalProperties": false
    },
    "expenses": {
      "type": "object",
      "description": "Expense details covering current spending and projected retirement expenses.",
      "required": ["monthly_expenses", "annual_expenses", "retirement_annual_expenses", "retirement_expense_ratio"],
      "properties": {
        "monthly_expenses": {
          "type": "number",
          "minimum": 0,
          "description": "Total monthly living expenses.",
          "default": 0
        },
        "annual_expenses": {
          "type": "number",
          "minimum": 0,
          "description": "Total annual living expenses.",
          "default": 0
        },
        "retirement_annual_expenses": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated annual expenses during retirement (may differ from current expenses).",
          "default": 0
        },
        "retirement_expense_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Ratio of retirement expenses to current expenses (e.g., 0.8 means 80% of current expenses in retirement).",
          "default": 0.8
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "description": "Current asset holdings across various investment categories.",
      "required": ["cash", "stocks", "etf", "bonds", "crypto", "real_estate", "other"],
      "properties": {
        "cash": {
          "type": "number",
          "minimum": 0,
          "description": "Cash in savings accounts, checking accounts, and money market funds.",
          "default": 0
        },
        "stocks": {
          "type": "number",
          "minimum": 0,
          "description": "Value of individual stock holdings.",
          "default": 0
        },
        "etf": {
          "type": "number",
          "minimum": 0,
          "description": "Value of exchange-traded fund holdings.",
          "default": 0
        },
        "bonds": {
          "type": "number",
          "minimum": 0,
          "description": "Value of bond holdings including government and corporate bonds.",
          "default": 0
        },
        "crypto": {
          "type": "number",
          "minimum": 0,
          "description": "Value of cryptocurrency holdings.",
          "default": 0
        },
        "real_estate": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated equity value of real estate holdings (market value minus mortgage).",
          "default": 0
        },
        "other": {
          "type": "number",
          "minimum": 0,
          "description": "Value of other assets not categorized above.",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "liabilities": {
      "type": "object",
      "description": "Outstanding debts and financial obligations.",
      "required": ["mortgage", "consumer_debt", "other"],
      "properties": {
        "mortgage": {
          "type": "number",
          "minimum": 0,
          "description": "Remaining mortgage balance.",
          "default": 0
        },
        "consumer_debt": {
          "type": "number",
          "minimum": 0,
          "description": "Outstanding consumer debt (credit cards, auto loans, personal loans).",
          "default": 0
        },
        "other": {
          "type": "number",
          "minimum": 0,
          "description": "Other liabilities not categorized above (student loans, etc.).",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "investment": {
      "type": "object",
      "description": "Investment assumptions and contribution plans.",
      "required": ["monthly_contribution", "expected_return", "inflation_rate", "withdrawal_rate"],
      "properties": {
        "monthly_contribution": {
          "type": "number",
          "minimum": 0,
          "description": "Planned monthly investment contribution.",
          "default": 0
        },
        "expected_return": {
          "type": "number",
          "minimum": -1,
          "maximum": 10,
          "description": "Expected annual investment return rate as a decimal (e.g., 0.07 for 7%).",
          "default": 0.07
        },
        "inflation_rate": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Expected annual inflation rate as a decimal (e.g., 0.03 for 3%).",
          "default": 0.03
        },
        "withdrawal_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Safe withdrawal rate in retirement as a decimal (e.g., 0.04 for 4% rule).",
          "default": 0.04
        }
      },
      "additionalProperties": false
    }
  }
}
