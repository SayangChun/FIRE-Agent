{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fire-agent/schemas/fire_result.json",
  "title": "FIRE Analysis Result",
  "description": "Complete result of a FIRE (Financial Independence, Retire Early) analysis including projections, scenarios, risk assessment, and recommendations.",
  "type": "object",
  "required": [
    "summary",
    "financial_profile",
    "fire_number",
    "progress",
    "savings_rate",
    "estimated_fire_age",
    "scenarios",
    "monte_carlo",
    "fire_type",
    "readiness_score",
    "risks",
    "tradeoffs",
    "recommendations"
  ],
  "properties": {
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "financial_profile": {
      "$ref": "#/$defs/financial_profile"
    },
    "fire_number": {
      "$ref": "#/$defs/fire_number"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "savings_rate": {
      "$ref": "#/$defs/savings_rate"
    },
    "estimated_fire_age": {
      "type": "integer",
      "minimum": 18,
      "maximum": 100,
      "description": "Estimated age at which FIRE will be achieved under the base scenario."
    },
    "scenarios": {
      "$ref": "#/$defs/scenarios"
    },
    "monte_carlo": {
      "$ref": "#/$defs/monte_carlo"
    },
    "fire_type": {
      "$ref": "#/$defs/fire_type"
    },
    "readiness_score": {
      "$ref": "#/$defs/readiness_score"
    },
    "risks": {
      "type": "array",
      "description": "Identified risks that could derail the FIRE plan.",
      "items": {
        "$ref": "#/$defs/risk_item"
      }
    },
    "tradeoffs": {
      "type": "array",
      "description": "Key tradeoffs and opportunity costs of pursuing the current FIRE path.",
      "items": {
        "type": "object",
        "required": ["area", "description", "impact"],
        "properties": {
          "area": {
            "type": "string",
            "description": "Life area affected by the tradeoff."
          },
          "description": {
            "type": "string",
            "description": "Description of the tradeoff."
          },
          "impact": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Severity of the tradeoff impact."
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Prioritized actionable recommendations to improve FIRE progress.",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "description": "High-level summary of the FIRE analysis.",
      "required": ["current_net_worth", "years_to_fire", "fire_number", "readiness_grade"],
      "properties": {
        "current_net_worth": {
          "type": "number",
          "description": "Total net worth (assets minus liabilities)."
        },
        "years_to_fire": {
          "type": "number",
          "minimum": 0,
          "description": "Number of years until projected FIRE date."
        },
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "Target portfolio size needed for financial independence."
        },
        "readiness_grade": {
          "type": "string",
          "enum": ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "F"],
          "description": "Overall readiness grade."
        },
        "one_liner": {
          "type": "string",
          "description": "Brief one-sentence summary of the FIRE outlook."
        }
      },
      "additionalProperties": false
    },
    "financial_profile": {
      "type": "object",
      "description": "Snapshot of the financial profile used in this analysis.",
      "required": ["age", "target_fire_age", "annual_income", "annual_expenses", "net_worth", "savings_rate"],
      "properties": {
        "age": {
          "type": "integer",
          "description": "Current age."
        },
        "target_fire_age": {
          "type": "integer",
          "description": "Desired FIRE age."
        },
        "annual_income": {
          "type": "number",
          "description": "Annual net income."
        },
        "annual_expenses": {
          "type": "number",
          "description": "Annual living expenses."
        },
        "net_worth": {
          "type": "number",
          "description": "Current net worth."
        },
        "savings_rate": {
          "type": "number",
          "description": "Current savings rate as a decimal."
        }
      },
      "additionalProperties": false
    },
    "fire_number": {
      "type": "object",
      "description": "The calculated FIRE number and its components.",
      "required": ["fire_number", "withdrawal_rate", "annual_retirement_expenses"],
      "properties": {
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "Target portfolio size for financial independence (annual expenses / withdrawal rate)."
        },
        "withdrawal_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Safe withdrawal rate used in the calculation."
        },
        "annual_retirement_expenses": {
          "type": "number",
          "minimum": 0,
          "description": "Projected annual expenses in retirement."
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "description": "Current progress toward the FIRE number.",
      "required": ["current_assets", "fire_number", "progress", "remaining"],
      "properties": {
        "current_assets": {
          "type": "number",
          "minimum": 0,
          "description": "Current invested assets."
        },
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "Target FIRE number."
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Progress toward FIRE as a decimal (0 to 1)."
        },
        "remaining": {
          "type": "number",
          "minimum": 0,
          "description": "Remaining amount needed to reach FIRE number."
        }
      },
      "additionalProperties": false
    },
    "savings_rate": {
      "type": "object",
      "description": "Savings rate analysis.",
      "required": ["savings_rate", "annual_savings", "monthly_savings"],
      "properties": {
        "savings_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Savings rate as a decimal (savings / income)."
        },
        "annual_savings": {
          "type": "number",
          "minimum": 0,
          "description": "Total annual savings amount."
        },
        "monthly_savings": {
          "type": "number",
          "minimum": 0,
          "description": "Total monthly savings amount."
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "object",
      "description": "FIRE projections under different market scenarios.",
      "required": ["conservative", "base", "optimistic"],
      "properties": {
        "conservative": {
          "$ref": "#/$defs/scenario_result"
        },
        "base": {
          "$ref": "#/$defs/scenario_result"
        },
        "optimistic": {
          "$ref": "#/$defs/scenario_result"
        }
      },
      "additionalProperties": false
    },
    "scenario_result": {
      "type": "object",
      "description": "Result of a single scenario projection.",
      "required": ["return_rate", "inflation_rate", "fire_number", "fire_age"],
      "properties": {
        "return_rate": {
          "type": "number",
          "description": "Annual investment return rate for this scenario."
        },
        "inflation_rate": {
          "type": "number",
          "description": "Inflation rate used in this scenario."
        },
        "fire_number": {
          "type": "number",
          "minimum": 0,
          "description": "FIRE number calculated for this scenario."
        },
        "fire_age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 100,
          "description": "Projected age at FIRE for this scenario."
        },
        "final_assets": {
          "type": "number",
          "description": "Projected portfolio value at the time of FIRE."
        }
      },
      "additionalProperties": false
    },
    "monte_carlo": {
      "type": "object",
      "description": "Monte Carlo simulation results for robustness analysis.",
      "required": ["success_probability", "median_final_assets", "percentiles"],
      "properties": {
        "success_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of reaching FIRE number (typically from 1000+ simulations)."
        },
        "median_final_assets": {
          "type": "number",
          "description": "Median final portfolio value across all simulations."
        },
        "percentiles": {
          "type": "object",
          "description": "Portfolio value at various percentiles.",
          "properties": {
            "p10": {
              "type": "number",
              "description": "10th percentile (pessimistic outcome)."
            },
            "p25": {
              "type": "number",
              "description": "25th percentile."
            },
            "p50": {
              "type": "number",
              "description": "50th percentile (median)."
            },
            "p75": {
              "type": "number",
              "description": "75th percentile."
            },
            "p90": {
              "type": "number",
              "description": "90th percentile (optimistic outcome)."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fire_type": {
      "type": "object",
      "description": "Classification of the type of FIRE achievable.",
      "required": ["type", "reason", "confidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["lean_fire", "regular_fire", "fat_fire", "barista_fire", "coast_fire"],
          "description": "Type of FIRE classification."
        },
        "reason": {
          "type": "string",
          "description": "Explanation for why this FIRE type was assigned."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence level in this classification."
        }
      },
      "additionalProperties": false
    },
    "readiness_score": {
      "type": "object",
      "description": "Multi-dimensional readiness assessment.",
      "required": ["total_score", "grade", "dimensions"],
      "properties": {
        "total_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall readiness score out of 100."
        },
        "grade": {
          "type": "string",
          "enum": ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "F"],
          "description": "Letter grade corresponding to the total score."
        },
        "dimensions": {
          "type": "object",
          "description": "Scores across individual readiness dimensions.",
          "properties": {
            "savings_efficiency": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Score for savings rate and efficiency."
            },
            "investment_growth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Score for investment return assumptions."
            },
            "timeline_feasibility": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Score for how realistic the FIRE timeline is."
            },
            "risk_resilience": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Score for ability to withstand market downturns."
            },
            "expense_control": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Score for expense management relative to income."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "risk_item": {
      "type": "object",
      "description": "A single identified risk factor.",
      "required": ["name", "severity", "reason", "mitigation"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name or category of the risk."
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Severity level of the risk."
        },
        "reason": {
          "type": "string",
          "description": "Explanation of why this is a risk."
        },
        "mitigation": {
          "type": "string",
          "description": "Suggested mitigation strategy."
        }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "description": "A single actionable recommendation.",
      "required": ["priority", "category", "action", "expected_impact", "effort"],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1,
          "description": "Priority order (1 = highest)."
        },
        "category": {
          "type": "string",
          "enum": ["savings", "income", "investment", "expenses", "tax", "debt", "insurance", "estate"],
          "description": "Category of the recommendation."
        },
        "action": {
          "type": "string",
          "description": "Specific action to take."
        },
        "expected_impact": {
          "type": "string",
          "description": "Expected impact on FIRE timeline or security."
        },
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Effort required to implement."
        }
      },
      "additionalProperties": false
    }
  }
}
